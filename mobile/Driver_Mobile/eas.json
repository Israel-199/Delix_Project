{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DELIX_API_HOST": "https://delix-project-1.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DELIX_API_HOST": "https://delix-project-1.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
