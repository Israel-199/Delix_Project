datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum DriverStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  OFFLINE
}

enum VehicleType {
  LADA_BED
  PICKUP_TRUCK
  MINI_TRUCK
  LARGE_TRUCK
}

enum OrderStatus {
  SEARCHING_DRIVER
  DRIVER_ACCEPTED
  ARRIVED_PICKUP
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum CargoCategory {
  FURNITURE
  CONSTRUCTION_MATERIALS
  SHOP_GOODS
  DOCUMENTS
  OTHER
}

enum DriverDocumentType {
  LICENSE
  NATIONAL_ID
  REGISTRATION_BOOK
  INSURANCE
}

model User {
  id              String   @id @default(uuid())
  phone           String   @unique
  firstName       String?
  middleName      String?
  lastName        String?
  profilePhotoUrl String?
  role      Role     @default(CUSTOMER)
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverProfile Driver?
  customerOrders Order[]  @relation("CustomerOrders")
  savedLocations SavedLocation[]
  notifications Notification[]
}

model Driver {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber     String       @default(uuid())
  vehicleType       VehicleType
  plateNumber       String       @unique
  photoUrl          String?
  nationalId        String?
  vehicleCargoType  String?
  vehicleOwnerName  String?
  insuranceInfo     String?
  bankAccount       String?
  address           String?
  status            DriverStatus @default(PENDING_APPROVAL)
  completedTrips    Int          @default(0)
  commissionBalance Float        @default(0.0)
  currentLat        Float?
  currentLng        Float?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  assignedOrders    Order[]      @relation("DriverOrders")
  documents         DriverDocument[]
}

model Order {
  id                  String        @id @default(uuid())
  customerId          String
  customer            User          @relation("CustomerOrders", fields: [customerId], references: [id])
  driverId            String?
  driver              Driver?       @relation("DriverOrders", fields: [driverId], references: [id])
  cargoCategory       CargoCategory
  cargoDescription    String?
  cargoPhotoUrl       String?
  vehicleRequested    VehicleType
  pickupAddress       String
  pickupLat           Float
  pickupLng           Float
  destinationAddress  String
  destinationLat      Float
  destinationLng      Float
  loadingAssistance   Boolean       @default(false)
  unloadingAssistance Boolean       @default(false)
  distanceKm          Float
  estimatedPrice      Float
  status              OrderStatus   @default(SEARCHING_DRIVER)
  tripStartedAt       DateTime?
  startLat            Float?
  startLng            Float?
  paymentMethod       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model PricingMatrix {
  id           String      @id @default(uuid())
  vehicleType  VehicleType @unique
  baseFare     Float
  perKmRate    Float
  loadingFee   Float
  unloadingFee Float
  updatedAt    DateTime    @updatedAt
}

model PricingSettings {
  id                 String   @id @default("default")
  baseFare           Float    @default(300)
  distanceRatePerKm  Float    @default(90)
  waitingRatePerHour Float    @default(50)
  updatedAt          DateTime @updatedAt
}

model SavedLocation {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeName      String
  address        String
  latitude       Float
  longitude      Float
  selectionCount Int      @default(1)
  lastSelectedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, latitude, longitude])
  @@index([userId, lastSelectedAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DriverDocument {
  id        String             @id @default(uuid())
  driverId  String
  driver    Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type      DriverDocumentType
  url       String
  publicId  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([driverId, type])
  @@index([driverId])
}
